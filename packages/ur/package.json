{
  "name": "@qntx/ur",
  "version": "1.8.0",
  "description": "Uniform Resources (UR) transport for JavaScript/TypeScript — Bytewords, fountain codes, and multi-part UR.",
  "keywords": [
    "blockchain-commons",
    "bytewords",
    "fountain",
    "qr",
    "uniform-resources",
    "ur"
  ],
  "homepage": "https://github.com/qntx/ur#readme",
  "bugs": {
    "url": "https://github.com/qntx/ur/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/ur.git",
    "directory": "packages/ur"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./registry": {
      "types": "./dist/registry.d.mts",
      "import": "./dist/registry.mjs",
      "default": "./dist/registry.mjs"
    },
    "./typed": {
      "types": "./dist/typed.d.mts",
      "import": "./dist/typed.mjs",
      "default": "./dist/typed.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "check:pkg": "vp pack && publint && attw --pack . --profile esm-only",
    "smoke:hermes": "bun scripts/hermes-smoke.ts",
    "prepublishOnly": "vp run build",
    "bench": "BENCH=1 vp test bench/decoder.bench.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@blockchaincommons/dcbor": "1.0.0-beta.3",
    "@qntx/tsconfig": "1.0.1",
    "@types/node": "26.6.3",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "@blockchaincommons/dcbor": "1.0.0-beta.3"
  },
  "peerDependenciesMeta": {
    "@blockchaincommons/dcbor": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
