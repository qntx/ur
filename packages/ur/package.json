{
  "name": "@qntx/ur",
  "version": "1.8.0",
  "description": "Uniform Resources (UR) transport for JavaScript/TypeScript — Bytewords, fountain codes, and multi-part UR.",
  "keywords": [
    "blockchain-commons",
    "bytewords",
    "fountain",
    "qr",
    "uniform-resources",
    "ur"
  ],
  "homepage": "https://github.com/qntx/ur.js#readme",
  "bugs": {
    "url": "https://github.com/qntx/ur.js/issues"
  },
  "license": "MIT",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/ur.js.git",
    "directory": "packages/ur"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./registry": {
      "types": "./dist/registry.d.mts",
      "import": "./dist/registry.mjs",
      "default": "./dist/registry.mjs"
    },
    "./typed": {
      "types": "./dist/typed.d.mts",
      "import": "./dist/typed.mjs",
      "default": "./dist/typed.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@blockchaincommons/dcbor": "1.0.0-beta.3",
    "@qntx/tsconfig": "^1.0.1",
    "@types/node": "^26.6.3",
    "bumpp": "^12.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.3"
  },
  "peerDependencies": {
    "@blockchaincommons/dcbor": "1.0.0-beta.3"
  },
  "peerDependenciesMeta": {
    "@blockchaincommons/dcbor": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
